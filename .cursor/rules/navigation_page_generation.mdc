### 2. **EnhancedPageHistoryManager** 🗂️
**Purpose**: Core history management with LRU cleanup
**Location**: `Models/PageHistoryEntry.swift`
**Key Features**:
- 100-page history limit
- LRU-based cleanup strategy
- Layout compatibility management
- Bidirectional navigation support

**History Management**:
```swift
class EnhancedPageHistoryManager: ObservableObject {
    @Published private var history: [PageHistoryEntry] = []
    @Published private var currentIndex: Int = -1
    private let maxHistorySize = 100
    
    func pushPage(_ entry: PageHistoryEntry) {
        // Remove forward history if not at end
        if currentIndex >= 0 && currentIndex < history.count - 1 {
            history.removeSubrange((currentIndex + 1)...)
        }
        
        // Add new entry
        history.append(entry)
        currentIndex = history.count - 1
        
        // Trim history if too large
        if history.count > maxHistorySize {
            history.removeFirst(history.count - maxHistorySize)
            currentIndex = history.count - 1
        }
    }
}
```

**Integration Points**:
- **Page Generation**: History entry creation
- **Layout Management**: Compatibility validation
- **Memory Management**: LRU cleanup
- **Navigation**: Bidirectional support

## 🔄 Navigation Flow Patterns

### 1. **Forward Navigation** ➡️
```swift
// 1. Check cached next page
if let node = currentNode?.next {
    currentNode = node
    currentPage = node.slice
    return
}

// 2. Handle pending remainder
if let remain = pending {
    await generatePage(startingAt: (remain.key.book, remain.key.chapter, remain.key.verse))
    return
}

// 3. Generate new page
guard let last = currentNode?.slice.endVerse,
      let next = await findNextVerse(after: last) else { return }
await generatePage(startingAt: (next.book, next.chapter, next.verse))
```

### 2. **Backward Navigation** ⬅️
```swift
// 1. Check cached previous page
if let node = currentNode?.prev {
    currentNode = node
    currentPage = node.slice
    return
}

// 2. Use enhanced history
if historyManager.canGoBackward, let historyEntry = historyManager.goBackward() {
    isNavigatingFromHistory = true
    defer { isNavigatingFromHistory = false }
    
    if await restorePageFromHistory(historyEntry) {
        return
    }
}

// 3. NO FALLBACK - Only allow when history exists
lastError = "Cannot navigate backwards - no page history available"
```

### 3. **History Restoration** 🔄
```swift
func restorePageFromHistory(_ entry: PageHistoryEntry) async -> Bool {
    // Check layout compatibility
    guard entry.isCompatibleWith(
        pageSize: currentPageSize,
        horizontalPadding: LayoutMetrics.horizontalPagePadding,
        verticalPadding: LayoutMetrics.verticalPagePadding
    ) else {
        print("❌ Layout incompatible, clearing history")
        historyManager.clearHistory()
        return false
    }
    
    // Restore from serialized data if available
    if let serializedData = entry.serializedFragmentedPage,
       let restoredPage = try? JSONDecoder().decode(FragmentedPage.self, from: serializedData) {
        currentFragmentedPage = restoredPage
        return true
    }
    
    // Fallback to metadata-based restoration
    return await restoreFromMetadata(entry)
}
```

## 🚨 Navigation Error Handling

### 1. **Layout Compatibility Errors** 📐
```swift
// Automatic cleanup of incompatible entries
func cleanupIncompatibleEntries(pageSize: CGSize, horizontalPadding: CGFloat, verticalPadding: CGFloat) {
    let compatibleEntries = history.filter { entry in
        entry.isCompatibleWith(pageSize: pageSize, horizontalPadding: horizontalPadding, verticalPadding: verticalPadding)
    }
    
    if compatibleEntries.count != history.count {
        print("📚 Cleaned up \(history.count - compatibleEntries.count) incompatible entries")
        history = compatibleEntries
        currentIndex = min(currentIndex, history.count - 1)
    }
}
```

### 2. **Memory Pressure Handling** 🧠
```swift
// Memory pressure response
func handleMemoryPressure() {
    Task {
        await cache.clear()
        print("🧹 Memory pressure: Cleared page cache")
    }
}
```

### 3. **Navigation Unavailable Errors** 🚫
```swift
// Clear error messaging
if !historyManager.canGoBackward {
    lastError = "Cannot navigate backwards - no page history available"
    return
}
```

## 📊 Performance Optimization

### 1. **Linked List Caching** 🔗
```swift
// Efficient navigation with linked list
private final class SliceNode {
    let key: VerseKey
    let slice: OptimizedPageSlice
    weak var prev: SliceNode?
    weak var next: SliceNode?
}

// Fast navigation
if let node = currentNode?.next {
    currentNode = node
    currentPage = node.slice
    return
}
```

### 2. **LRU Cache Management** 💾
```swift
// Automatic cache trimming
private func trimCacheToThreePages() async {
    let keys = await cache.keys
    if keys.count > 3 {
        let keysToRemove = Array(keys.dropFirst(3))
        for key in keysToRemove {
            await cache.remove(key)
        }
    }
}
```

### 3. **Dynamic Size Adaptation** 📐
```swift
// Size change handling
func updatePageSize(_ new: CGSize) {
    guard size != new else { return }
    let oldSize = size
    size = new
    
    // Clear ALL cached state since layout calculations are now invalid
    pending = nil
    currentNode = nil
    currentPage = nil
    currentGeneratedPage = nil
    currentFragmentedPage = nil
    
    // Clear enhanced page history since page layout has changed
    historyManager.clearHistory()
    
    // Force clear text formatter cache too
    JITTextFormatter.clearCache()
}
```


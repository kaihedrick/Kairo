### 2. **Dependency Injection for Testing** 🔌
**Reference**: `DI/DependencyContainer.swift` - DI container
```swift
// Test-specific container
class TestDependencyContainer: DependencyContainer {
    override func registerServices() {
        // Register mock services for testing
        register(BibleServiceProtocol.self) { MockBibleService() }
        register(MLServiceProtocol.self) { MockMLService() }
        register(NavigationServiceProtocol.self) { MockNavigationService() }
    }
}

// Usage in tests
class BibleViewModelTests: XCTestCase {
    var container: TestDependencyContainer!
    var viewModel: BibleViewModel!
    
    override func setUp() {
        super.setUp()
        container = TestDependencyContainer()
        viewModel = BibleViewModel(container: container)
    }
}
```

### 3. **Test Data Management** 📊
- **Mock Data**: Create realistic test data for consistent testing
- **Test Fixtures**: Use predefined test scenarios
- **Data Factories**: Generate test data programmatically
- **Cleanup**: Ensure tests don't affect each other

## 🔬 Unit Testing Patterns

### 1. **Service Layer Testing** 🧠
**Reference**: `Services/BibleCommentaryGenerator.swift` - Service testing
```swift
class BibleCommentaryGeneratorTests: XCTestCase {
    var generator: BibleCommentaryGenerator!
    var mockTokenizer: MockGPT2Tokenizer!
    var mockModel: MockMLModel!
    
    override func setUp() {
        super.setUp()
        mockTokenizer = MockGPT2Tokenizer()
        mockModel = MockMLModel()
        generator = BibleCommentaryGenerator(
            tokenizer: mockTokenizer,
            model: mockModel
        )
    }
    
    func testGenerateCommentarySuccess() async throws {
        // Given
        let verse = "John 3:16"
        mockTokenizer.tokenizeResult = [1, 2, 3, 4, 5]
        mockModel.predictionResult = "Generated commentary"
        
        // When
        let result = await generator.generateCommentary(for: verse)
        
        // Then
        XCTAssertEqual(result.commentary, "Generated commentary")
        XCTAssertEqual(result.modelVersion, "Mock Model")
    }
    
    func testGenerateCommentaryWithFallback() async throws {
        // Given
        let verse = "John 3:16"
        mockTokenizer.tokenizeResult = nil // Simulate failure
        
        // When
        let result = await generator.generateCommentary(for: verse)
        
        // Then
        XCTAssertTrue(result.commentary.contains("Unable to generate AI commentary"))
        XCTAssertEqual(result.modelVersion, "Fallback Response")
    }
}
```

### 2. **ViewModel Testing** 📱
```swift
class BibleViewModelTests: XCTestCase {
    var viewModel: BibleViewModel!
    var mockService: MockBibleService!
    
    func testLoadBibleDataSuccess() async {
        // Given
        let expectedBooks = [Book(name: "Genesis", chapters: 50)]
        mockService.loadBooksResult = .success(expectedBooks)
        
        // When
        await viewModel.loadBibleData()
        
        // Then
        XCTAssertEqual(viewModel.books.count, 1)
        XCTAssertEqual(viewModel.books.first?.name, "Genesis")
        XCTAssertFalse(viewModel.isLoading)
        XCTAssertNil(viewModel.error)
    }
    
    func testLoadBibleDataFailure() async {
        // Given
        let error = BibleError.dataNotFound("Bible data not found")
        mockService.loadBooksResult = .failure(error)
        
        // When
        await viewModel.loadBibleData()
        
        // Then
        XCTAssertTrue(viewModel.books.isEmpty)
        XCTAssertFalse(viewModel.isLoading)
        XCTAssertEqual(viewModel.error, error)
    }
}
```

### 3. **Model Testing** 📊
```swift
class BibleModelsTests: XCTestCase {
    func testVerseReferenceValidation() {
        // Valid references
        XCTAssertNotNil(VerseReference(book: "Genesis", chapter: 1, verse: 1))
        XCTAssertNotNil(VerseReference(book: "Revelation", chapter: 22, verse: 21))
        
        // Invalid references
        XCTAssertNil(VerseReference(book: "", chapter: 1, verse: 1))
        XCTAssertNil(VerseReference(book: "Genesis", chapter: 0, verse: 1))
        XCTAssertNil(VerseReference(book: "Genesis", chapter: 1, verse: 0))
    }
    
    func testServiceResultWrapper() {
        let successResult: ServiceResult<String> = .success("Success")
        let failureResult: ServiceResult<String> = .failure(.invalidInput("Invalid"))
        
        XCTAssertEqual(successResult.value, "Success")
        XCTAssertNil(successResult.error)
        
        XCTAssertNil(failureResult.value)
        XCTAssertEqual(failureResult.error, .invalidInput("Invalid"))
    }
}
```

## 🔗 Integration Testing

### 1. **ML Pipeline Testing** 🧠
**Reference**: `INTEGRATION_TODO.md` - Integration testing requirements
```swift
class MLPipelineIntegrationTests: XCTestCase {
    var pipeline: MLPipeline!
    
    func testEndToEndCommentaryGeneration() async throws {
        // Given
        let verse = "Matthew 1:3"
        
        // When
        let result = try await pipeline.generateCommentary(for: verse)
        
        // Then
        XCTAssertFalse(result.commentary.isEmpty)
        XCTAssertFalse(result.devotional.isEmpty)
        XCTAssertTrue(result.commentary.contains("[END_COMMENTARY]"))
        XCTAssertTrue(result.devotional.contains("[END_DEVOTIONAL]"))
    }
    
    func testTokenizerRoundTrip() throws {
        // Given
        let input = "MATTHEW_1_3"
        
        // When
        let tokens = try pipeline.tokenizer.encode(input)
        let output = try pipeline.tokenizer.decode(tokens)
        
        // Then
        XCTAssertEqual(output, input)
    }
}
```

### 2. **Navigation System Testing** 🧭
**Reference**: `ENHANCED_BACKWARD_NAVIGATION_V2.md` - Navigation testing
```swift
class NavigationIntegrationTests: XCTestCase {
    var navigationManager: EnhancedPageHistoryManager!
    var pageGenerator: OnDemandPageGenerator!
    
    func testBidirectionalNavigation() async throws {
        // Given
        let initialPage = try await pageGenerator.generatePage()
        
        // When - Navigate forward
        let forwardPage = try await pageGenerator.generateNextPage()
        let backPage = try await pageGenerator.generatePreviousPage()
        
        // Then
        XCTAssertEqual(backPage.startBook, initialPage.startBook)
        XCTAssertEqual(backPage.startChapter, initialPage.startChapter)
        XCTAssertEqual(backPage.startVerse, initialPage.startVerse)
        XCTAssertEqual(backPage.renderedContent, initialPage.renderedContent)
    }
    
    func testLayoutCompatibility() async throws {
        // Given
        let page = try await pageGenerator.generatePage()
        let historyEntry = navigationManager.createHistoryEntry(from: page)
        
        // When - Change screen size
        let newSize = CGSize(width: 800, height: 600)
        let isCompatible = navigationManager.isLayoutCompatible(historyEntry, with: newSize)
        
        // Then
        XCTAssertFalse(isCompatible)
        XCTAssertTrue(navigationManager.history.isEmpty)
    }
}
```

### 3. **Data Flow Testing** 📊
```swift
class DataFlowIntegrationTests: XCTestCase {
    var dataLoader: OptimizedBibleDataLoader!
    var viewModel: BibleViewModel!
    
    func testDataLoadingToDisplay() async throws {
        // Given
        let bookName = "Genesis"
        
        // When
        let books = try await dataLoader.loadBooks()
        let genesis = books.first { $0.name == bookName }
        let chapters = try await dataLoader.loadChapters(for: genesis!)
        let verses = try await dataLoader.loadVerses(for: chapters[0])
        
        // Then
        XCTAssertEqual(genesis?.name, bookName)
        XCTAssertEqual(chapters.count, 50)
        XCTAssertEqual(verses.count, 31)
    }
}
```

## 🎨 UI Testing

### 1. **User Workflow Testing** 👤
**Reference**: `BibleAppPOCV2UITests/` - UI test structure
```swift
class BibleAppUITests: XCTestCase {
    var app: XCUIApplication!
    
    override func setUp() {
        super.setUp()
        app = XCUIApplication()
        app.launch()
    }
    
    func testCompleteBibleReadingWorkflow() {
        // Select a book
        let bookGrid = app.collectionViews["bookGrid"]
        let genesisCell = bookGrid.cells["Genesis"]
        genesisCell.tap()
        
        // Select a chapter
        let chapterGrid = app.collectionViews["chapterGrid"]
        let chapter1Cell = chapterGrid.cells["Chapter 1"]
        chapter1Cell.tap()
        
        // Navigate through verses
        let readerView = app.scrollViews["readerView"]
        readerView.swipeLeft()
        
        // Verify navigation
        XCTAssertTrue(app.staticTexts["Chapter 2"].exists)
    }
    
    func testVerseSummaryGeneration() {
        // Navigate to a verse
        let readerView = app.scrollViews["readerView"]
        let verseText = readerView.staticTexts["In the beginning God created the heavens and the earth."]
        verseText.tap()
        
        // Verify summary popup
        let summaryPopup = app.otherElements["summaryPopup"]
        XCTAssertTrue(summaryPopup.exists)
        
        // Verify content sections
        XCTAssertTrue(summaryPopup.staticTexts["Commentary"].exists)
        XCTAssertTrue(summaryPopup.staticTexts["Devotional"].exists)
    }
}
```


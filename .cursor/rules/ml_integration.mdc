## 🏗️ **Clean ML Architecture**

### **1. Single Source of Truth**
```swift
// VocabService.swift - Single source for token decoding
final class VocabService {
    static let shared = VocabService()
    private let map: [Int: String]
    
    private init() {
        let url = Bundle.main.url(forResource: "id_to_token", withExtension: "json", subdirectory: "Models")!
        let data = try! Data(contentsOf: url)
        let raw = try! JSONSerialization.jsonObject(with: data) as! [String: Any]
        var temp = [Int: String]()
        temp.reserveCapacity(raw.count)
        for (k, v) in raw {
            if let id = Int(k), let tok = v as? String { temp[id] = tok }
        }
        self.map = temp
    }
    
    func token(for id: Int) -> String { map[id] ?? "[UNK]" }
}
```

### **2. Clean Token Decoding**
```swift
extension Array where Element == Int {
    func decodeToString() -> String {
        let vocab = VocabService.shared
        // Naive join; post-formatters can be applied outside
        return self.map { vocab.token(for: $0) }.joined()
    }
}
```

### **3. Special Token Management**
```swift
// ExportReportService.swift - Load special token IDs
final class ExportReportService {
    static let shared = ExportReportService()
    let report: ExportReport
    
    private init() {
        let url = Bundle.main.url(forResource: "export_report", withExtension: "json", subdirectory: "Models")!
        let data = try! Data(contentsOf: url)
        self.report = try! JSONDecoder().decode(ExportReport.self, from: data)
    }
    
    func id(for special: Special) -> Int? { 
        report.special_token_ids[special.rawValue] 
    }
}
```

## 🔧 **Core ML Model Integration**

### **1. Model Loading**
```swift
// CommentaryModel.swift - Clean model loading
final class CommentaryModel {
    static let shared = CommentaryModel()
    let model: MLModel
    let nLayer: Int, nHead: Int, headDim: Int
    
    private init() {
        let url = Bundle.main.url(forResource: "bible_commentary_model", withExtension: "mlpackage", subdirectory: "Models")!
        self.model = try! MLModel(contentsOf: url)
        let io = ExportReportService.shared.report.model_io
        nLayer = io.n_layer
        nHead = io.n_head
        headDim = io.head_dim
    }
}
```

### **2. Generation Runtime**
```swift
// Generator.swift - Single-token step with KV cache
final class Generator {
    private let ml = CommentaryModel.shared.model
    private let nLayer = CommentaryModel.shared.nLayer
    private let nHead = CommentaryModel.shared.nHead
    private let headDim = CommentaryModel.shared.headDim
    
    func step(tokenId: Int32, kv: KV?) throws -> (logits: [Float], next: KV) {
        var inputs: [String: Any] = [:]
        
        // input_ids: shape (1,1), attention_mask: (1,1)
        let ids = try MLMultiArray(shape: [1, 1], dataType: .int32)
        ids[0] = NSNumber(value: tokenId)
        let mask = try MLMultiArray(shape: [1, 1], dataType: .int32)
        mask[0] = 1
        
        inputs["input_ids"] = ids
        inputs["attention_mask"] = mask
        
        let caches = kv ?? emptyCaches()
        for i in 0..<nLayer { 
            inputs["k_cache_\(i)"] = caches.k[i]
            inputs["v_cache_\(i)"] = caches.v[i] 
        }
        
        let out = try ml.prediction(from: MLDictionaryFeatureProvider(dictionary: inputs))
        let logitsMA = out.featureValue(for: "logits")!.multiArrayValue!
        let logits = (0..<logitsMA.count).map { Float(truncating: logitsMA[$0]) }
        
        var nextK: [MLMultiArray] = []
        var nextV: [MLMultiArray] = []
        for i in 0..<nLayer {
            nextK.append(out.featureValue(for: "present_k_\(i)")!.multiArrayValue!)
            nextV.append(out.featureValue(for: "present_v_\(i)")!.multiArrayValue!)
        }
        
        return (logits, KV(k: nextK, v: nextV))
    }
}
```

## 🧪 **Parity Verification**

### **1. Parity Testing**
```swift
// ParityVerifier.swift - Runtime confidence
func verifyParity() -> Bool {
    guard let url = Bundle.main.url(forResource: "parity_fixture", withExtension: "json", subdirectory: "Parity"),
          let data = try? Data(contentsOf: url),
          let fix = try? JSONDecoder().decode(ParityFixture.self, from: data) else { 
        return false 
    }
    
    // Run Core ML with fixture prompt
    let prompt = fix.metadata.input_ids.map { Int32($0) }
    let outIds = try? generate(promptIds: prompt, maxNewTokens: 0, strategy: .greedy)
    
    // Compare shapes and top-k indices as smoke test
    return true
}
```


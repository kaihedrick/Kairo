## 🎨 **Typography & Text Display**

### **1. Clean Text First**
```swift
// Apply formatting AFTER clean text generation
func renderFromDecoded(_ decoded: String) -> VerseRender {
    // Split around special tokens (already removed / not emitted in final text)
    // Or better: operate at token level, find ranges where IDs == START/END, then decode that span to string
    return VerseRender(
        id: "MARK_1_2", 
        ref: "Mark 1:2", 
        text: "…", 
        commentary: decoded
    )
}
```

### **2. Post-Generation Formatting**
```swift
struct VerseRender {
    let id: String
    let ref: String
    let text: String
    let commentary: String
    
    var formattedCommentary: AttributedString {
        var attributed = AttributedString(commentary)
        
        // Apply typography to clean text
        attributed.font = .system(.body, design: .serif)
        attributed.foregroundColor = .primary
        
        // Highlight key phrases
        if let range = attributed.range(of: "**") {
            attributed[range].font = .system(.body, design: .serif, weight: .bold)
        }
        
        return attributed
    }
}
```

### **3. No Heavy Sanitizers in UI**
```swift
// DO: Apply formatting to clean text
func formatCleanText(_ text: String) -> AttributedString {
    var attributed = AttributedString(text)
    // Apply typography, spacing, etc.
    return attributed
}

// DON'T: Try to fix corrupted text in UI layer
func formatCorruptedText(_ text: String) -> AttributedString {
    // ❌ Don't do this - fix corruption at source
    let sanitized = text.replacingOccurrences(of: "Ć", with: "")
    // ... more sanitization
    return AttributedString(sanitized)
}
```

## 🎭 **Glass Effects & Modern Design**

### **1. Glass Tile Implementation**
```swift
struct GlassTile: ViewModifier {
    func body(content: Content) -> some View {
        content
            .background(.ultraThinMaterial)
            .background(.ultraThinMaterial, in: RoundedRectangle(cornerRadius: 16))
            .overlay(
                RoundedRectangle(cornerRadius: 16)
                    .stroke(.white.opacity(0.2), lineWidth: 1)
            )
            .shadow(color: .black.opacity(0.1), radius: 10, x: 0, y: 5)
    }
}

extension View {
    func glassTile() -> some View {
        modifier(GlassTile())
    }
}
```

### **2. Responsive Layout**
```swift
struct ResponsiveGrid<Content: View>: View {
    let columns: [GridItem]
    let content: Content
    
    init(columns: [GridItem] = Array(repeating: .init(.flexible()), count: 2), @ViewBuilder content: () -> Content) {
        self.columns = columns
        self.content = content()
    }
    
    var body: some View {
        LazyVGrid(columns: columns, spacing: 16) {
            content
        }
        .padding(.horizontal)
    }
}
```

## 📱 **Accessibility & User Experience**

### **1. Proper Text Labels**
```swift
struct VerseSummaryView: View {
    let verse: VerseRender
    
    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text(verse.ref)
                .font(.title2)
                .fontWeight(.semibold)
                .accessibilityLabel("Verse reference: \(verse.ref)")
            
            Text(verse.commentary)
                .font(.body)
                .accessibilityLabel("Bible commentary for \(verse.ref)")
                .accessibilityHint("AI-generated commentary explaining the verse")
        }
        .glassTile()
    }
}
```


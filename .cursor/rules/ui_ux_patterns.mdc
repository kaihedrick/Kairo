## 🔄 **State Management & Updates**

### **1. Clean State Updates**
```swift
@MainActor
class VerseViewModel: ObservableObject {
    @Published var currentVerse: VerseRender?
    @Published var isLoading = false
    @Published var error: String?
    
    func generateCommentary(for verseRef: String) async {
        isLoading = true
        error = nil
        
        do {
            // Generate clean text from model
            let cleanText = try await generateCleanText(for: verseRef)
            
            // Apply formatting to clean text
            let formatted = formatCleanText(cleanText)
            
            // Update UI state
            currentVerse = VerseRender(
                id: verseRef,
                ref: verseRef,
                text: "",
                commentary: formatted
            )
        } catch {
            self.error = error.localizedDescription
        }
        
        isLoading = false
    }
}
```

### **2. Error Presentation**
```swift
struct ErrorView: View {
    let error: String
    let retryAction: () -> Void
    
    var body: some View {
        VStack(spacing: 16) {
            Image(systemName: "exclamationmark.triangle")
                .font(.largeTitle)
                .foregroundColor(.orange)
                .accessibilityHidden(true)
            
            Text("Something went wrong")
                .font(.headline)
                .accessibilityLabel("Error occurred")
            
            Text(error)
                .font(.subheadline)
                .foregroundColor(.secondary)
                .multilineTextAlignment(.center)
                .accessibilityLabel("Error details: \(error)")
            
            Button("Try Again") {
                retryAction()
            }
            .buttonStyle(.borderedProminent)
            .accessibilityLabel("Retry operation")
        }
        .glassTile()
    }
}
```

## 🎯 **Implementation Guidelines**

### **DO: Clean UI Patterns**
- ✅ Apply formatting **after** clean text generation
- ✅ Use glass effects and modern iOS design
- ✅ Implement proper accessibility labels
- ✅ Handle loading and error states gracefully
- ✅ Trust the clean exported data

### **DON'T: Complex Sanitization in UI**
- ❌ Don't implement aggressive text sanitization in UI layer
- ❌ Don't try to fix corrupted text with formatting
- ❌ Don't bypass the clean text pipeline
- ❌ Don't treat symptoms instead of root causes

## 🔍 **Text Health Monitoring**

### **1. Debug Logging**
```swift
#if DEBUG
func logTextHealth(_ text: String, label: String) {
    let first200Bytes = String(text.prefix(200))
    let hexBytes = first200Bytes.utf8.map { String(format: "%02X", $0) }.joined(separator: " ")
    print("🔍 \(label) - First 200 bytes: \(hexBytes)")
}
#endif
```

### **2. Special Token Validation**
```swift
func validateNoSpecialTokens(_ text: String) -> Bool {
    let specialTokens = ExportReportService.shared.report.special_token_ids.keys
    return !specialTokens.contains { text.contains($0) }
}
```


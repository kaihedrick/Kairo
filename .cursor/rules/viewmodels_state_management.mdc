## 🔧 Dependency Injection Patterns

### 1. **Constructor Injection** 🔌
```swift
// Dependency injection support
init(repository: BibleRepositoryProtocol? = nil) {
    self.repository = repository
    Task {
        await initializeData()
    }
}

// Usage with dependency injection
let viewModel = OptimizedBibleViewModel(repository: mockRepository)
```

### 2. **Service Locator Pattern** 🏪
```swift
// Shared service instances
static let shared = VerseSummaryViewModel()

// Service coordination
bibleCommentaryGenerator = BibleCommentaryGenerator.shared
improvedSummarizer = ImprovedBibleSummarizer()
```

### 3. **Protocol-Based Dependencies** 📋
```swift
// Protocol-based dependencies
private let repository: BibleRepositoryProtocol?

// Usage with protocol abstraction
if let repository = repository {
    let loadedMetadata = try await repository.loadMetadata()
    metadata = loadedMetadata
} else {
    // Fallback to direct loader
    try await dataLoader.loadBibleMetadata()
    metadata = await dataLoader.metadata
}
```

## 📊 Performance Optimization

### 1. **MainActor Usage** 🎯
```swift
// Proper MainActor usage for UI updates
@MainActor
class OptimizedBibleViewModel: ObservableObject {
    // All published properties automatically update on main thread
}

// Explicit MainActor usage for async operations
await MainActor.run {
    self.metadata = loadedMetadata
    self.initializationProgress = 1.0
}
```

### 2. **Weak Reference Management** 🔗
```swift
// Weak reference to prevent retain cycles
NotificationCenter.default.addObserver(
    forName: .coreMLBibleModelReady, 
    object: nil, 
    queue: .main
) { [weak self] _ in
    Task { @MainActor in
        self?.modelAvailable = true
        // ... state updates
    }
}
```

### 3. **Efficient State Updates** ⚡
```swift
// Batch state updates
await MainActor.run {
    self.isLoading = false
    self.commentaryText = result.commentary
    self.devotionalText = result.devotional
